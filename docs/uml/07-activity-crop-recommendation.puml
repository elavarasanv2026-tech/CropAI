@startuml
start

:Receive POST /api/crop-recommendation;
:Extract soil, climate, season,\nwater availability, farm size,\nNPK, pH, rainfall, temperature, humidity;

if (Required farm inputs present?) then (yes)
  :Normalize nested currentConditions;
  :Apply safe defaults for missing NPK/weather values;
  :Call dataset recommendation builder;

  if (Dataset result available?) then (yes)
    :Build recommendation payload\nwith quotations and summaries;
    :Return JSON response;
  else (no)
    :Build LLM prompt;
    :Request AI recommendation output;

    if (LLM response valid?) then (yes)
      :Return AI recommendation JSON;
    else (no)
      :Return failure or fallback response;
    endif
  endif
else (no)
  :Return 400 validation error;
endif

stop
@enduml
