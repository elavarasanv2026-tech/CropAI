@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Farmer
actor "Google User" as GoogleUser
actor Admin
actor "Email Service" as EmailService
actor "OpenRouter / LLM" as OpenRouter
actor "Plant.id API" as PlantId
actor "Kindwise Crop Health API" as Kindwise
actor "Open-Meteo API" as WeatherApi

rectangle CropAI {
  usecase "Sign Up" as UCSignup
  usecase "Verify Email" as UCVerify
  usecase "Login / Logout" as UCLogin
  usecase "Google / Social Login" as UCSocial
  usecase "Reset Password" as UCReset
  usecase "Manage Profile" as UCProfile
  usecase "Save Selected Crop" as UCSaveCrop
  usecase "Remove Selected Crop" as UCRemoveCrop
  usecase "Get Crop Recommendations" as UCRecommend
  usecase "Analyze Crop Photo" as UCAnalyze
  usecase "Detect Crop From Image" as UCDetect
  usecase "Ask CropAI Assistant" as UCChat
  usecase "View Weather / Climate Data" as UCWeather
  usecase "Load IoT Sensor Data" as UCSensors
  usecase "View Market Insights" as UCMarket
  usecase "Run Soil Analysis" as UCSoil
}

Farmer --> UCSignup
Farmer --> UCVerify
Farmer --> UCLogin
Farmer --> UCReset
Farmer --> UCProfile
Farmer --> UCSaveCrop
Farmer --> UCRemoveCrop
Farmer --> UCRecommend
Farmer --> UCAnalyze
Farmer --> UCDetect
Farmer --> UCChat
Farmer --> UCWeather
Farmer --> UCSensors
Farmer --> UCMarket
Farmer --> UCSoil

GoogleUser --> UCSocial
Admin --> UCMarket
Admin --> UCWeather

UCSignup --> EmailService
UCVerify --> EmailService
UCReset --> EmailService
UCSocial --> GoogleUser
UCAnalyze --> Kindwise
UCDetect --> PlantId
UCChat --> OpenRouter
UCWeather --> WeatherApi

UCProfile .> UCSaveCrop : <<include>>
UCProfile .> UCRemoveCrop : <<include>>
UCRecommend .> UCWeather : <<extend>>
UCRecommend .> UCSensors : <<extend>>
UCAnalyze .> UCDetect : <<include>>
@enduml
