@startuml
actor Farmer
participant "dashboard.html" as Dashboard
participant "server.js" as Server
collections "Dynamic Dataset Engine" as Engine
collections "Crop Datasets\nCSV + cultivation catalog" as Dataset
participant "LLM / OpenRouter" as LLM

Farmer -> Dashboard : Fill soil, climate,\nseason, water, farm size
Dashboard -> Server : POST /api/crop-recommendation
Server -> Server : validate required farm inputs

alt missing farm inputs
  Server --> Dashboard : 400 validation error
else valid request
  Server -> Server : normalize currentConditions\napply defaults for NPK/ph/weather
  Server -> Engine : buildDynamicDatasetRecommendations(input)
  Engine -> Dataset : read recommendation profiles\nand cultivation metadata
  Dataset --> Engine : matching crop data
  Engine --> Server : recommendation set / no match

  alt dataset recommendations available
    Server --> Dashboard : JSON recommendations
  else no dataset result
    Server -> LLM : generate JSON recommendation report
    LLM --> Server : recommendation payload
    Server --> Dashboard : JSON recommendations
  end
end

Dashboard -> Farmer : Render crop cards,\nprofitability, yield,\ncondition summary
@enduml
