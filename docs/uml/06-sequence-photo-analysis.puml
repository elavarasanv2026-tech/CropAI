@startuml
actor Farmer
participant "dashboard.html" as Dashboard
participant "server.js" as Server
participant "multer + sharp" as UploadPipeline
participant "services/kindwiseClient.js" as Client
participant "Plant.id API" as PlantId
participant "Kindwise Crop Health API" as Kindwise

Farmer -> Dashboard : Upload crop image
Dashboard -> Server : POST /api/analyze-photo\nmultipart/form-data
Server -> UploadPipeline : receive file\nvalidate mime and size

alt invalid image
  UploadPipeline --> Server : invalid upload
  Server --> Dashboard : 400 error
else valid image
  UploadPipeline --> Server : normalized JPEG buffer
  Server -> Client : requestPlantIdIdentification(base64)
  Client -> PlantId : POST identification
  PlantId --> Client : crop candidates
  Client --> Server : parsed crop identity

  Server -> Client : requestCropHealthIdentification(base64)
  Client -> Kindwise : POST health assessment
  Kindwise --> Client : disease / treatment response
  Client --> Server : parsed health response

  Server -> Server : merge crop + disease + fallback fields
  Server --> Dashboard : success JSON analysis
end

Dashboard -> Farmer : Show crop name,\nconfidence, health,\ntreatment, care tips
@enduml
