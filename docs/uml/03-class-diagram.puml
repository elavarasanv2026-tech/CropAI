@startuml
skinparam classAttributeIconSize 0

class ServerApp {
  +Express app
  +connectMongoDB()
  +requireAuth(req,res,next)
  +buildSafeUserResponse(user)
  +sanitizeUserProfilePayload(payload, existingUser)
  +hydrateSelectedCrops(user)
  +buildCropQuotation(selection, user)
}

class User {
  +name : String
  +username : String
  +email : String
  +password : String
  +isVerified : Boolean
  +verificationToken : String
  +avatar : String
  +role : String
  +phone : String
  +address : String
  +location : String
  +farmSize : Number
  +preferredCrops : String
  +selectedCrops : Array
  +createdAt : Date
  +updatedAt : Date
}

class SelectedCrop {
  +id : String
  +crop : String
  +selectedAt : ISODate
  +recommendationSnapshot : Object
  +selectionContext : Object
}

class CropQuotation {
  +crop : String
  +acreage : Number
  +seedRequirement : String
  +basalFertilizer : String
  +topDressFertilizer : String
  +manureRequirement : String
  +landPreparation : String
  +ploughingSchedule : String
  +sowingMethod : String
  +irrigationGuidance : String
  +cropDuration : String
  +expectedHarvestTime : String
  +daysToHarvest : String
  +estimatedCost : String
  +importantNotes : String[]
}

class Database {
  -filename : String
  -data : Object
  +loadData()
  +saveData()
  +createUser(userData)
  +findUserByEmail(email)
  +findUserByUsername(username)
  +findUserById(id)
  +findUserByEmailOrUsername(email, username)
  +updateUser(id, updates)
}

class MockUser {
  +findOne(query)
  +findById(id)
  +findByIdAndUpdate(id, updates)
  +create(data)
}

class KindwiseClient {
  +externalApiConfig
  +mapExternalApiError(error, fallbackMessage)
  +requestPlantIdIdentification(base64Image)
  +requestCropHealthIdentification(base64Image)
}

class CropRecommendationEngine {
  +buildDynamicDatasetRecommendations(input)
  +normalizeCropIdentity(value)
  +buildCropSelectionId(selection)
  +buildPreferredCropText(selectedCrops, fallbackPreferred)
}

class MailService {
  +sendBrandedEmail(options)
}

class Session {
  +userId : String
  +loginIdentifier : String
  +user : Object
}

ServerApp --> User : reads/writes
ServerApp --> Database : JSON fallback
ServerApp --> MockUser : fallback adapter
ServerApp --> KindwiseClient : delegates image APIs
ServerApp --> CropRecommendationEngine : recommendation logic
ServerApp --> MailService : verification/reset emails
ServerApp --> Session : session auth

User "1" o-- "*" SelectedCrop
SelectedCrop --> CropQuotation : hydrated into
Database ..> User : stores user records
MockUser ..> Database : wraps
CropRecommendationEngine ..> SelectedCrop
@enduml
