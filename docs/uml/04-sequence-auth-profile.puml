@startuml
actor Farmer
participant "signup.html / login.html / profile.html" as UI
participant "server.js" as Server
participant "User Model / MockUser" as UserRepo
participant "SMTP / Mailer" as Mailer
participant "Session" as Session

== Signup ==
Farmer -> UI : Submit signup form
UI -> Server : POST /api/signup
Server -> UserRepo : findOne(email or username)
alt user already exists
  UserRepo --> Server : existing user
  Server --> UI : 400 duplicate error
else new user
  UserRepo --> Server : no user
  Server -> Server : hash password\ncreate verification token
  Server -> UserRepo : save user(isVerified=false)
  Server -> Mailer : send verification email
  Mailer --> Server : delivered / failed
  Server --> UI : 201 signup result
end

== Email Verification ==
Farmer -> UI : Open verification link
UI -> Server : GET /verify/:token
Server -> UserRepo : findOne(verificationToken)
alt token valid
  UserRepo --> Server : user found
  Server -> UserRepo : save isVerified=true\nclear token
  Server --> UI : verification success
else token invalid
  Server --> UI : verification failure
end

== Login ==
Farmer -> UI : Submit identifier + password
UI -> Server : POST /api/login
Server -> UserRepo : findOne(email or username)
Server -> Server : bcrypt.compare()
alt valid and verified
  Server -> Session : store userId + user snapshot
  Server --> UI : login success
else invalid / unverified
  Server --> UI : auth error
end

== Profile ==
Farmer -> UI : Open profile page
UI -> Server : GET /api/user
Server -> Session : validate requireAuth
Server -> UserRepo : findById(session.userId)
Server -> Server : buildSafeUserResponse()\nhydrateSelectedCrops()
Server --> UI : profile payload

Farmer -> UI : Update profile / save crop / remove crop
UI -> Server : PUT /api/user\nPOST /api/user/selected-crops\nDELETE /api/remove-crop/:id
Server -> UserRepo : findById / update
Server -> Server : sanitize payload\nrebuild preferred crops
UserRepo --> Server : updated user
Server --> UI : updated profile payload
@enduml
